{
  "//": "示例插件的类型校验（ROADMAP #32.10）：checkJs + 全局类型 plugin-api.d.ts。运行：pnpm exec tsc -p examples/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["plugins/**/*.d.ts", "plugins/list-demo/main.js"]
}
