{
  "api": 2,
  "disabledPlugin": {
    "unloadsLogicFrame": true,
    "revokesCapabilityTokens": true,
    "receivesLifecycleHooks": false,
    "capabilityCallsAllowed": false
  },
  "honoredContributions": {
    "navBars": {
      "enabled": true,
      "maxBarsPerPlugin": 8,
      "maxItemsPerPlugin": 120,
      "maxBytesPerPlugin": 196608,
      "maxBarsPerPage": 32,
      "maxItemsPerPage": 320,
      "maxBytesPerPage": 524288,
      "emptyQueryBlocksNavigation": false
    },
    "provider": {
      "enabled": true,
      "searchMode": "concurrent",
      "timeoutMsPerProvider": 6000,
      "maxRowsPerResult": 64,
      "maxBytesPerPluginResult": 196608,
      "syntheticRowsActivationOnly": true,
      "drillRequiresSelect": true,
      "featureRegexWorkerTimeoutMs": 50
    },
    "icons": {
      "httpSupported": false,
      "allowedSchemes": [
        "data",
        "asset",
        "blob"
      ],
      "relativePathsResolveAgainstPluginDir": true
    },
    "listTemplate": {
      "enabled": true,
      "usesProviderRowBudget": true,
      "staleSearchesAreInvalidated": true,
      "onShowOncePerDisplay": true
    }
  },
  "presenter": {
    "component": "page-runtime",
    "staleMountsAreCancelled": true,
    "supersededHandlesAreDisposed": true,
    "destroyedSessionRemounts": false,
    "readyReplayOrder": [
      "model",
      "settings",
      "theme",
      "skin",
      "snapshot",
      "query",
      "show",
      "enter"
    ],
    "passwordValuesRedacted": true,
    "switchResetsModalAndLayout": true
  },
  "logicHost": {
    "notReadyHooksCountTowardCircuitBreaker": false,
    "unloadRejectsPendingCalls": true
  },
  "pageService": {
    "startupEventsQueued": true,
    "replayOrder": [
      "query",
      "settings",
      "filesDropped",
      "show",
      "enter"
    ]
  },
  "privateFiles": {
    "canonicalPluginDirectory": true,
    "idMayDifferFromDirectoryName": true
  },
  "clipboard": {
    "ownWriteGuard": "clipboard-sequence",
    "preservesOuterWhitespace": true,
    "htmlTruncation": "utf8-boundary"
  },
  "recentOpens": {
    "recordsNavigateLaunchesOnly": true,
    "pluginOpenCommand": "open_path"
  }
}
