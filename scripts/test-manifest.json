{
  "suites": {
    "smoke": {
      "module": "suites/smoke.mjs",
      "description": "Launcher shell, hidden resource lifecycle, mode switching and clipboard surface"
    },
    "settings": {
      "module": "suites/settings.mjs",
      "description": "Lazy settings lifecycle, navigation, search surface and clipboard pane"
    },
    "plugin-runtime": {
      "module": "suites/plugin-runtime.mjs",
      "description": "API 2 plugin entry, Presenter readiness and sandbox"
    },
    "clipboard-ui": {
      "module": "suites/clipboard-ui.mjs",
      "description": "Clipboard surface, pause acknowledgement and clear confirmation"
    },
    "preview": {
      "module": "suites/preview.mjs",
      "description": "Blank startup, core PDF/preview lifecycle and plugin permission gate"
    },
    "agent": {
      "module": "suites/agent.mjs",
      "description": "Elevation-agent settings, status shape and fail-closed registration gate"
    }
  },
  "impact": [
    {
      "paths": ["scripts/test-harness/", "scripts/test-manifest.json", "scripts/verify.mjs"],
      "suites": ["smoke", "settings", "plugin-runtime", "clipboard-ui", "preview", "agent"]
    },
    {
      "paths": ["src/plugins/", "src/page-runtime/", "src/page-services/", "src/presenters/"],
      "suites": ["smoke", "plugin-runtime"]
    },
    {
      "paths": ["src/plugins/clipboard/", "src/page-services/clipboard/", "src/presenters/clipboard-list/", "src/presenters/clipboard-compact/"],
      "suites": ["clipboard-ui"]
    },
    {
      "paths": ["src/settings/", "src/skins/", "languages/"],
      "suites": ["settings"]
    },
    {
      "paths": ["src/shell/"],
      "suites": ["smoke", "settings"]
    },
    {
      "paths": ["src/launcher/previewHost.ts", "src-tauri/src/window.rs", "src/preview.tsx", "examples/plugins/host-tools/"],
      "suites": ["preview", "smoke"]
    },
    {
      "paths": ["src-tauri/src/plugin_", "src-tauri/src/plugins.rs", "public/pluginLogicFrame.js", "src/pluginLogic.tsx"],
      "suites": ["plugin-runtime", "preview"]
    },
    {
      "paths": ["src/settings/AutomationPane.tsx", "src/settings/SystemPane.tsx", "src-tauri/src/agent.rs"],
      "suites": ["agent", "settings"]
    }
  ],
  "fallbackSuites": ["smoke"],
  "legacyGroups": {
    "plugin-boundary": [
      "scripts/cdp_plugin_nav_clipboard_fix_verify.mjs",
      "scripts/cdp_audit_r2_verify.mjs"
