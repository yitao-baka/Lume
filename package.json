{
  "name": "lume",
  "version": "3.2.0",
  "description": "A lightweight Windows productivity launcher.",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/check_plugin_contract.mjs && vite build",
    "test": "node scripts/verify.mjs fast",
    "test:clipboard-model": "node scripts/clipboard_model_unit_test.mjs",
    "test:clipboard-store": "node scripts/clipboard_store_unit_test.mjs",
    "test:page-runtime": "node scripts/page_runtime_unit_test.mjs",
    "test:plugin-contract": "node scripts/check_plugin_contract.mjs",
    "test:skin-system": "node scripts/skin_system_unit_test.mjs",
    "verify:docs": "node scripts/verify.mjs docs",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify:ui": "node scripts/verify.mjs ui",
    "verify:ui:changed": "node scripts/verify.mjs ui --changed",
    "verify:legacy": "node scripts/verify.mjs legacy",
    "verify:release": "node scripts/verify.mjs release",
    "serve": "vite preview",
    "tauri": "tauri",
    "package:zip": "node scripts/package-portable.mjs"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "i18next": "^26.3.6",
    "pdfjs-dist": "^6.2.108",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
